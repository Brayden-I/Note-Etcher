<?xml version="1.0" encoding="utf-8"?>
<ScreenSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>SettingsMenu</Name>
  <State>
    <Name>Default</Name>
    <Variable Type="float" Name="BackButton.Height" SetsValue="true">
      <Value xsi:type="xsd:float">46</Value>
    </Variable>
    <Variable Type="string" Name="BackButton.Text" SetsValue="true">
      <Value xsi:type="xsd:string">Back to Main Menu</Value>
    </Variable>
    <Variable Type="float" Name="BackButton.X" SetsValue="true">
      <Value xsi:type="xsd:float">0</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="BackButton.XUnits" SetsValue="true">
      <Value xsi:type="xsd:int">2</Value>
    </Variable>
    <Variable Type="float" Name="BackButton.Y" SetsValue="true">
      <Value xsi:type="xsd:float">100</Value>
    </Variable>
    <Variable Type="VerticalAlignment" Name="BackButton.YOrigin" SetsValue="true">
      <Value xsi:type="xsd:int">2</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="BackButton.YUnits" SetsValue="true">
      <Value xsi:type="xsd:int">3</Value>
    </Variable>
    <Variable Type="int" Name="Header.FontSize" SetsValue="true">
      <Value xsi:type="xsd:int">22</Value>
    </Variable>
    <Variable Type="bool" Name="Header.IsBold" SetsValue="true">
      <Value xsi:type="xsd:boolean">true</Value>
    </Variable>
    <Variable Type="string" Name="Header.Text" SetsValue="true">
      <Value xsi:type="xsd:string">Settings</Value>
    </Variable>
    <Variable Type="float" Name="Header.X" SetsValue="true">
      <Value xsi:type="xsd:float">1</Value>
    </Variable>
    <Variable Type="float" Name="Header.Y" SetsValue="true">
      <Value xsi:type="xsd:float">60</Value>
    </Variable>
    <Variable Type="int" Name="Title.Blue" SetsValue="true">
      <Value xsi:type="xsd:int">218</Value>
    </Variable>
    <Variable Type="int" Name="Title.FontSize" SetsValue="true">
      <Value xsi:type="xsd:int">48</Value>
    </Variable>
    <Variable Type="int" Name="Title.Green" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="bool" Name="Title.IsBold" SetsValue="true">
      <Value xsi:type="xsd:boolean">true</Value>
    </Variable>
    <Variable Type="int" Name="Title.Red" SetsValue="true">
      <Value xsi:type="xsd:int">117</Value>
    </Variable>
    <Variable Type="string" Name="Title.Text" SetsValue="true">
      <Value xsi:type="xsd:string">Note Etcher</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="Title.XUnits" SetsValue="true">
      <Value xsi:type="xsd:int">2</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="Title.YUnits" SetsValue="true">
      <Value xsi:type="xsd:int">3</Value>
    </Variable>
  </State>
  <Instance Name="Title" BaseType="Text" />
  <Instance Name="BackButton" BaseType="Controls/ButtonStandard" />
  <Instance Name="Header" BaseType="Text" />
  <Behaviors />
</ScreenSave>